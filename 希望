    /* =========================================================
       拖曳
    ========================================================= */

    function setupDrag(
        target,
        handle
    ) {

        let dragging = false;

        let startX = 0;
        let startY = 0;

        let startLeft = 0;
        let startTop = 0;

        function begin(e) {

            if (
                e.target &&
                e.target.tagName ===
                'BUTTON'
            ) {
                return;
            }

            dragging = true;

            const point =
                e.touches
                    ? e.touches[0]
                    : e;

            startX =
                point.clientX;

            startY =
                point.clientY;

            const rect =
                target.getBoundingClientRect();

            startLeft =
                rect.left;

            startTop =
                rect.top;

            target.style.right =
                'auto';

            target.style.left =
                startLeft + 'px';

            target.style.top =
                startTop + 'px';

            if (
                e.cancelable
            ) {
                e.preventDefault();
            }
        }

        function move(e) {

            if (!dragging) {
                return;
            }

            const point =
                e.touches
                    ? e.touches[0]
                    : e;

            let left =
                startLeft +
                (
                    point.clientX -
                    startX
                );

            let top =
                startTop +
                (
                    point.clientY -
                    startY
                );

            const margin = 5;

            left =
                Math.max(
                    margin,
                    Math.min(
                        window.innerWidth -
                        target.offsetWidth -
                        margin,
                        left
                    )
                );

            top =
                Math.max(
                    margin,
                    Math.min(
                        window.innerHeight -
                        Math.min(
                            target.offsetHeight,
                            window.innerHeight
                        ) -
                        margin,
                        top
                    )
                );

            target.style.left =
                left + 'px';

            target.style.top =
                top + 'px';

            panelData.left =
                left;

            panelData.top =
                top;
        }

        function end() {

            if (!dragging) {
                return;
            }

            dragging = false;

            savePanelData();
        }

        /* PC */

        handle.addEventListener(
            'mousedown',
            begin
        );

        document.addEventListener(
            'mousemove',
            move
        );

        document.addEventListener(
            'mouseup',
            end
        );

        /* 手機 */

        handle.addEventListener(
            'touchstart',
            begin,
            {
                passive:false
            }
        );

        document.addEventListener(
            'touchmove',
            move,
            {
                passive:false
            }
        );

        document.addEventListener(
            'touchend',
            end
        );
    }

    /* =========================================================
