        }

        document.body.appendChild(
            buildPanel()
        );

        mobileAdjust();

        startSessionWatcher();

        startDisabledButtonBypass();

        log(
            'v3 面板已啟動'
        );
    }

    if (
        document.readyState ===
        'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            mountPanel
        );

    } else {

        mountPanel();
    }

