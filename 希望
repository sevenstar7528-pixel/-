    ========================================================= */

    function startDisabledButtonBypass() {

        setInterval(
            () => {

                if (
                    !toggles.skipEvolveMaterials
                ) {
                    return;
                }

                try {

                    const rows =
                        document.querySelectorAll(
                            '.evolve-row'
                        );

                    for (
                        const row
                        of rows
                    ) {

                        const button =
                            row.querySelector(
                                'button.primary-btn[disabled]'
                            );

                        if (button) {

                            button.removeAttribute(
                                'disabled'
                            );
                        }
                    }

                } catch (e) {}
            },
            300
        );
    }

    /* =========================================================
       防止手機畫面跑版
    ========================================================= */

    function mobileAdjust() {

        if (!panel) {
            return;
        }

        if (
            window.innerWidth <= 600
        ) {

            panel.style.maxWidth =
                'calc(100vw - 10px)';

            panel.style.maxHeight =
                '75vh';

            if (
                panel.offsetWidth >
                window.innerWidth - 10
            ) {

                panel.style.width =
                    Math.max(
                        220,
                        window.innerWidth -
                        10
                    ) + 'px';
            }

            const rect =
                panel.getBoundingClientRect();

            if (
                rect.right >
                window.innerWidth
            ) {

                panel.style.left =
                    Math.max(
                        5,
                        window.innerWidth -
                        panel.offsetWidth -
                        5
                    ) + 'px';

                panel.style.right =
                    'auto';
            }

            if (
                rect.bottom >
                window.innerHeight
            ) {

                panel.style.top =
                    Math.max(
                        5,
                        window.innerHeight -
                        panel.offsetHeight -
                        5
                    ) + 'px';
            }
        }
    }

    window.addEventListener(
        'resize',
        mobileAdjust
    );

