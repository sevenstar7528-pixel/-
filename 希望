// ==UserScript==
// @name         放置希望 改機面板 v3
// @namespace    idle-seal-cheat-panel
// @version      3.0.0
// @description  放置希望改機面板：倍率調整、寵物進化、寵物+9、裝備+12、能力值設定；支援收合、手機觸控拖曳與面板縮放
// @author       ChatGPT
// @match        https://idle-seal.pp771007.workers.dev/*
// @run-at       document-idle
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        unsafeWindow
// ==/UserScript==

(function () {
    'use strict';

    /* =========================================================
       設定
    ========================================================= */

    const STORE_KEY = 'idle_seal_mults_v3';

    const DEFAULTS = {
        moveSpeed: 5,
        gold: 5,
        exp: 5,
        dmg: 5,
        respawn: 5,
        fame: 5,
        drop: 5
    };

    const TOGGLE_KEY = 'idle_seal_toggles_v3';

    const TOGGLE_DEFAULTS = {
        skipEvolveMaterials: false,
        maxPetGrow: false,
        maxRefine: false
    };

    const PANEL_KEY = 'idle_seal_panel_v3';

    /* =========================================================
       儲存
    ========================================================= */

    function loadMults() {
        try {
            const saved = GM_getValue(STORE_KEY, null);

            if (saved && typeof saved === 'object') {
                return Object.assign({}, DEFAULTS, saved);
            }
        } catch (e) {}

        return Object.assign({}, DEFAULTS);
    }

    function saveMults() {
        try {
            GM_setValue(STORE_KEY, mults);
        } catch (e) {}
    }

    function loadToggles() {
        try {
            const saved = GM_getValue(TOGGLE_KEY, null);

            if (saved && typeof saved === 'object') {
                return Object.assign({}, TOGGLE_DEFAULTS, saved);
            }
        } catch (e) {}

        return Object.assign({}, TOGGLE_DEFAULTS);
    }

    function saveToggles() {
        try {
            GM_setValue(TOGGLE_KEY, toggles);
        } catch (e) {}
    }

    function loadPanelData() {
        try {
            const saved = GM_getValue(PANEL_KEY, null);

            if (saved && typeof saved === 'object') {
                return saved;
            }
        } catch (e) {}

        return {
            left: null,
            top: 80,
            width: 300,
            collapsed: false
        };
    }

    function savePanelData() {
        try {
            GM_setValue(PANEL_KEY, panelData);
        } catch (e) {}
    }

    let mults = loadMults();
    let toggles = loadToggles();
    let panelData = loadPanelData();

    /* =========================================================
       Session
    ========================================================= */

    let session = null;

    let patchState = {
        active: false,
        proto: null
    };

    let locateTimer = null;

    /* =========================================================
       工具
    ========================================================= */

    function getWindow() {
        return typeof unsafeWindow !== 'undefined'
            ? unsafeWindow
            : window;
    }

    function log(...args) {
        console.log('[idle-seal v3]', ...args);
    }

    function warn(...args) {
        console.warn('[idle-seal v3]', ...args);
    }

    function isObject(v) {
        return v !== null && typeof v === 'object';
    }

    function looksLikeSession(obj) {
        return isObject(obj)
            && typeof obj.moveSpeed === 'function'
            && typeof obj.wornItems === 'function'
            && typeof obj.tick === 'function';
    }

    /* =========================================================
       搜尋 Session
    ========================================================= */

    function scanObjectGraph(root, maxDepth = 8, maxNodes = 50000) {

        const seen = new Set();

        const queue = [
            [root, 0]
        ];

        let count = 0;

        while (queue.length) {

            const item = queue.shift();

            const obj = item[0];
            const depth = item[1];

            if (!obj || typeof obj !== 'object') {
                continue;
            }

            if (seen.has(obj)) {
                continue;
            }

            seen.add(obj);

            count++;

            if (count > maxNodes) {
                break;
            }

            try {
                if (looksLikeSession(obj)) {
                    return obj;
                }
            } catch (e) {}

            if (depth >= maxDepth) {
                continue;
            }

            let keys;

            try {
                keys = Object.keys(obj);
            } catch (e) {
                continue;
            }

            for (const key of keys) {

                let value;

                try {
                    value = obj[key];
                } catch (e) {
                    continue;
                }

                if (
                    value &&
                    typeof value === 'object' &&
                    !seen.has(value)
                ) {
                    queue.push([
                        value,
                        depth + 1
                    ]);
                }
            }
        }

        return null;
    }

    function findVueRoots() {

        const roots = [];

        let elements;

        try {
            elements = document.querySelectorAll('*');
        } catch (e) {
            return roots;
        }

        for (const el of elements) {

            let keys;

            try {
                keys = Object.keys(el);
            } catch (e) {
                continue;
            }

            for (const key of keys) {

                if (
                    key.indexOf('__vue') === 0 ||
                    key.indexOf('__vnode') === 0
                ) {

                    try {
                        const value = el[key];

                        if (value) {
                            roots.push(value);
                        }
                    } catch (e) {}
                }
            }
        }

        return roots;
    }

    function locateSession() {

        const uw = getWindow();

        /* 手動 session */
        try {
            if (
                uw.__idleSealManualSession &&
                looksLikeSession(uw.__idleSealManualSession)
            ) {
                return uw.__idleSealManualSession;
            }
        } catch (e) {}

        /* 已找到的 session */
        try {
            if (
                uw.__idleSealSession &&
                looksLikeSession(uw.__idleSealSession)
            ) {
                return uw.__idleSealSession;
            }
        } catch (e) {}

        /* Vue */
        const roots = findVueRoots();

        for (const root of roots) {

            const found = scanObjectGraph(
                root,
                8,
                50000
            );

            if (found) {
                return found;
            }
        }

        return null;
    }

    /* =========================================================
       Patch 工具
    ========================================================= */

    function markOriginal(proto, name, fn) {

        const key = '__idleSealV3_original_' + name;

        if (!proto[key]) {
            try {
                Object.defineProperty(proto, key, {
                    value: fn,
                    writable: true,
                    configurable: true
                });
            } catch (e) {
                proto[key] = fn;
            }
        }

        return proto[key];
    }

    function getOriginal(proto, name) {

        const key = '__idleSealV3_original_' + name;

        try {
            return proto[key] || null;
        } catch (e) {
            return null;
        }
    }

    function alreadyPatched(proto, name) {

        try {
            return !!proto['__idleSealV3_patch_' + name];
        } catch (e) {
            return false;
        }
    }

    function markPatched(proto, name) {

        try {
            Object.defineProperty(
                proto,
                '__idleSealV3_patch_' + name,
                {
                    value: true,
                    writable: true,
                    configurable: true
                }
            );
        } catch (e) {

            try {
                proto['__idleSealV3_patch_' + name] = true;
            } catch (err) {}
        }
    }

    /* =========================================================
       套用 Patch
    ========================================================= */

    function applyPatches(s) {

        if (!s) {
            return false;
        }

        let proto;

        try {
            proto = Object.getPrototypeOf(s);
        } catch (e) {
            return false;
        }

        if (!proto) {
            return false;
        }

        patchState.proto = proto;

        /* -----------------------------------------------------
           移動速度
        ----------------------------------------------------- */

        if (
            typeof proto.moveSpeed === 'function' &&
            !alreadyPatched(proto, 'moveSpeed')
        ) {

            const original = markOriginal(
                proto,
                'moveSpeed',
                proto.moveSpeed
            );

            proto.moveSpeed = function (...args) {

                const value = original.apply(
                    this,
                    args
                );

                try {

                    const multiplier =
                        Number(mults.moveSpeed) || 1;

                    return Math.round(
                        value * multiplier
                    );

                } catch (e) {

                    return value;
                }
            };

            markPatched(proto, 'moveSpeed');
        }

        /* -----------------------------------------------------
           經驗
        ----------------------------------------------------- */

        if (
            typeof proto.expPerKill === 'function' &&
            !alreadyPatched(proto, 'expPerKill')
        ) {

            const original = markOriginal(
                proto,
                'expPerKill',
                proto.expPerKill
            );

            proto.expPerKill = function (...args) {

                const value = original.apply(
                    this,
                    args
                );

                try {

                    const multiplier =
                        Number(mults.exp) || 1;

                    return Math.max(
                        1,
                        Math.round(
                            value * multiplier
                        )
                    );

                } catch (e) {

                    return value;
                }
            };

            markPatched(proto, 'expPerKill');
        }

        /* -----------------------------------------------------
           金錢
        ----------------------------------------------------- */

        if (
            typeof proto.sellSweep === 'function' &&
            !alreadyPatched(proto, 'sellSweep')
        ) {

            const original = markOriginal(
                proto,
                'sellSweep',
                proto.sellSweep
            );

            proto.sellSweep = function (...args) {

                let before = 0;

                try {

                    if (this.player) {
                        before =
                            Number(
                                this.player.gold
                            ) || 0;
                    }

                } catch (e) {}

                const result =
                    original.apply(
                        this,
                        args
                    );

                try {

                    if (
                        this.player &&
                        typeof this.player.gold === 'number'
                    ) {

                        const delta =
                            this.player.gold - before;

                        const multiplier =
                            Number(mults.gold) || 1;

                        if (
                            delta > 0 &&
                            multiplier > 1
                        ) {

                            this.player.gold +=
                                Math.round(
                                    delta *
                                    (multiplier - 1)
                                );
                        }
                    }

                } catch (e) {

                    warn(
                        '金錢倍率處理失敗',
                        e
                    );
                }

                return result;
            };

            markPatched(proto, 'sellSweep');
        }

        /* -----------------------------------------------------
           傷害
        ----------------------------------------------------- */

        if (
            typeof proto.tick === 'function' &&
            !alreadyPatched(proto, 'tick')
        ) {

            const original = markOriginal(
                proto,
                'tick',
                proto.tick
            );

            proto.tick = function (...args) {

                let backup = [];

                const multiplier =
                    Number(mults.dmg) || 1;

                try {

                    if (
                        multiplier > 1 &&
                        this.battle &&
                        Array.isArray(
                            this.battle.units
                        )
                    ) {

                        for (
                            const unit
                            of this.battle.units
                        ) {

                            if (
                                unit.side === 'ally' &&
                                unit.stats &&
                                typeof unit.stats.atk === 'number'
                            ) {

                                backup.push([
                                    unit,
                                    unit.stats.atk
                                ]);

                                unit.stats.atk =
                                    Math.round(
                                        unit.stats.atk *
                                        multiplier
                                    );
                            }
                        }
                    }

                } catch (e) {

                    backup = [];

                    warn(
                        '傷害倍率前置失敗',
                        e
                    );
                }

                let result;

                try {

                    result =
                        original.apply(
                            this,
                            args
                        );

                } finally {

                    try {

                        for (
                            const pair
                            of backup
                        ) {

                            pair[0].stats.atk =
                                pair[1];
                        }

                    } catch (e) {}
                }

                /* 寵物材料 */
                try {

                    if (
                        toggles.skipEvolveMaterials &&
                        Array.isArray(this.pets) &&
                        this.data &&
                        this.data.petById
                    ) {

                        for (
                            const pet
                            of this.pets
                        ) {

                            const def =
                                this.data.petById.get(
                                    pet.id
                                );

                            if (!def) {
                                continue;
                            }

                            if (
                                typeof pet.grow === 'number' &&
                                pet.grow < 9
                            ) {

                                pet.grow = 9;
                            }

                            if (
                                typeof def.feedFull === 'number' &&
                                typeof pet.exp === 'number' &&
                                pet.exp < def.feedFull
                            ) {

                                pet.exp =
                                    def.feedFull;
                            }
                        }
                    }

                } catch (e) {}

                return result;
            };

            markPatched(proto, 'tick');
        }

        /* -----------------------------------------------------
           重生
        ----------------------------------------------------- */

        if (
            typeof proto.tickRespawns === 'function' &&
            !alreadyPatched(proto, 'tickRespawns')
        ) {

            const original =
                markOriginal(
                    proto,
                    'tickRespawns',
                    proto.tickRespawns
                );

            let lastTime = null;

            proto.tickRespawns =
                function (...args) {

                    const result =
                        original.apply(
                            this,
                            args
                        );

                    try {

                        const now =
                            performance.now();

                        const dt =
                            lastTime === null
                                ? 0
                                : now - lastTime;

                        lastTime = now;

                        const multiplier =
                            Number(mults.respawn) || 1;

                        if (
                            multiplier > 1 &&
                            dt > 0 &&
                            Array.isArray(this.instances)
                        ) {

                            const extra =
                                dt *
                                (multiplier - 1);

                            for (
                                const enemy
                                of this.instances
                            ) {

                                if (
                                    !enemy.alive &&
                                    typeof enemy.respawnMs === 'number' &&
                                    enemy.respawnMs > 0
                                ) {

                                    enemy.respawnMs =
                                        Math.max(
                                            0,
                                            enemy.respawnMs -
                                            extra
                                        );

                                    if (
                                        enemy.respawnMs <= 0
                                    ) {

                                        enemy.alive = true;
                                        enemy.respawnMs = 0;

                                        this.dirty = true;
                                    }
                                }
                            }
                        }

                    } catch (e) {}

                    return result;
                };

            markPatched(
                proto,
                'tickRespawns'
            );
        }

        /* -----------------------------------------------------
           掉寶
        ----------------------------------------------------- */

        if (
            typeof proto.rewardKill === 'function' &&
            typeof proto.give === 'function' &&
            !alreadyPatched(proto, 'rewardKill')
        ) {

            const original =
                markOriginal(
                    proto,
                    'rewardKill',
                    proto.rewardKill
                );

            proto.rewardKill =
                function (...args) {

                    let before = null;

                    try {

                        if (
                            this.drops &&
                            typeof this.drops.forEach ===
                            'function'
                        ) {

                            before =
                                new Map(
                                    this.drops
                                );
                        }

                    } catch (e) {}

                    const result =
                        original.apply(
                            this,
                            args
                        );

                    try {

                        const multiplier =
                            Number(mults.drop) || 1;

                        if (
                            before &&
                            this.drops &&
                            multiplier > 1
                        ) {

                            for (
                                const [
                                    itemId,
                                    afterCount
                                ]
                                of this.drops
                            ) {

                                const beforeCount =
                                    before.get(
                                        itemId
                                    ) ?? 0;

                                const gained =
                                    afterCount -
                                    beforeCount;

                                if (gained > 0) {

                                    const extra =
                                        Math.round(
                                            gained *
                                            (multiplier - 1)
                                        );

                                    if (extra > 0) {

                                        this.give(
                                            itemId,
                                            extra
                                        );

                                        this.drops.set(
                                            itemId,
                                            (
                                                this.drops.get(
                                                    itemId
                                                ) ?? 0
                                            ) + extra
                                        );
                                    }
                                }
                            }
                        }

                    } catch (e) {}

                    return result;
                };

            markPatched(
                proto,
                'rewardKill'
            );
        }

        /* -----------------------------------------------------
           名聲
        ----------------------------------------------------- */

        if (
            typeof proto.submitQuest === 'function' &&
            !alreadyPatched(proto, 'submitQuest')
        ) {

            const original =
                markOriginal(
                    proto,
                    'submitQuest',
                    proto.submitQuest
                );

            proto.submitQuest =
                function (...args) {

                    let beforeCurrent = 0;
                    let beforeTotal = 0;

                    try {

                        if (
                            this.player &&
                            this.player.fame
                        ) {

                            beforeCurrent =
                                Number(
                                    this.player.fame.current
                                ) || 0;

                            beforeTotal =
                                Number(
                                    this.player.fame.total
                                ) || 0;
                        }

                    } catch (e) {}

                    const result =
                        original.apply(
                            this,
                            args
                        );

                    try {

                        const multiplier =
                            Number(mults.fame) || 1;

                        if (
                            multiplier > 1 &&
                            this.player &&
                            this.player.fame
                        ) {

                            const deltaCurrent =
                                this.player.fame.current -
                                beforeCurrent;

                            const deltaTotal =
                                this.player.fame.total -
                                beforeTotal;

                            if (deltaCurrent > 0) {

                                this.player.fame.current +=
                                    Math.round(
                                        deltaCurrent *
                                        (multiplier - 1)
                                    );
                            }

                            if (deltaTotal > 0) {

                                this.player.fame.total +=
                                    Math.round(
                                        deltaTotal *
                                        (multiplier - 1)
                                    );
                            }
                        }

                    } catch (e) {}

                    return result;
                };

            markPatched(
                proto,
                'submitQuest'
            );
        }

        /* -----------------------------------------------------
           buildPetView
        ----------------------------------------------------- */

        if (
            typeof proto.buildPetView === 'function' &&
            !alreadyPatched(proto, 'buildPetView')
        ) {

            const original =
                markOriginal(
                    proto,
                    'buildPetView',
                    proto.buildPetView
                );

            proto.buildPetView =
                function (...args) {

                    const result =
                        original.apply(
                            this,
                            args
                        );

                    try {

                        if (
                            toggles.skipEvolveMaterials &&
                            result &&
                            Array.isArray(
                                result.targets
                            )
                        ) {

                            for (
                                const target
                                of result.targets
                            ) {

                                target.blocked = false;

                                if (
                                    typeof target.need ===
                                    'number'
                                ) {

                                    target.have =
                                        target.need;
                                }
                            }
                        }

                    } catch (e) {}

                    return result;
                };

            markPatched(
                proto,
                'buildPetView'
            );
        }

        /* -----------------------------------------------------
           countOf
        ----------------------------------------------------- */

        if (
            typeof proto.countOf === 'function' &&
            !alreadyPatched(proto, 'countOf')
        ) {

            const original =
                markOriginal(
                    proto,
                    'countOf',
                    proto.countOf
                );

            proto.countOf =
                function (...args) {

                    if (
                        toggles.skipEvolveMaterials
                    ) {

                        return Infinity;
                    }

                    return original.apply(
                        this,
                        args
                    );
                };

            markPatched(
                proto,
                'countOf'
            );
        }

        /* -----------------------------------------------------
           take
        ----------------------------------------------------- */

        if (
            typeof proto.take === 'function' &&
            !alreadyPatched(proto, 'take')
        ) {

            const original =
                markOriginal(
                    proto,
                    'take',
                    proto.take
                );

            proto.take =
                function (...args) {

                    if (
                        toggles.skipEvolveMaterials
                    ) {

                        return;
                    }

                    return original.apply(
                        this,
                        args
                    );
                };

            markPatched(
                proto,
                'take'
            );
        }

        /* -----------------------------------------------------
           replacePet
        ----------------------------------------------------- */

        if (
            typeof proto.replacePet === 'function' &&
            !alreadyPatched(proto, 'replacePet')
        ) {

            const original =
                markOriginal(
                    proto,
                    'replacePet',
                    proto.replacePet
                );

            proto.replacePet =
                function (e) {

                    try {

                        if (
                            toggles.maxPetGrow &&
                            e &&
                            typeof e.grow === 'number' &&
                            e.grow < 9
                        ) {

                            e = Object.assign(
                                {},
                                e,
                                {
                                    grow: 9
                                }
                            );
                        }

                    } catch (err) {}

                    return original.call(
                        this,
                        e
                    );
                };

            markPatched(
                proto,
                'replacePet'
            );
        }

        /* -----------------------------------------------------
           refineStack
        ----------------------------------------------------- */

        if (
            typeof proto.refineStack === 'function' &&
            !alreadyPatched(proto, 'refineStack')
        ) {

            const original =
                markOriginal(
                    proto,
                    'refineStack',
                    proto.refineStack
                );

            proto.refineStack =
                function (e) {

                    if (!toggles.maxRefine) {

                        return original.call(
                            this,
                            e
                        );
                    }

                    try {

                        if (!this.inVillage) {
                            return;
                        }

                        const stack =
                            this.player &&
                            this.player.stacks
                                ? this.player.stacks.get(e)
                                : null;

                        if (
                            !stack ||
                            stack.locked ||
                            !this.data ||
                            !this.data.equipById ||
                            !this.data.equipById.has(
                                stack.itemId
                            )
                        ) {

                            return;
                        }

                        const name =
                            typeof this.itemName ===
                            'function'
                                ? this.itemName(
                                    stack.itemId
                                )
                                : '裝備';

                        stack.refine = 12;

                        if (
                            typeof this.push ===
                            'function'
                        ) {

                            this.push(
                                `${name} 精煉成功 → +12`,
                                'equip'
                            );
                        }

                        if (
                            typeof this.cue ===
                            'function'
                        ) {

                            this.cue(
                                'success'
                            );
                        }

                        if (
                            typeof this.refreshPlayerStats ===
                            'function'
                        ) {

                            this.refreshPlayerStats();
                        }

                        if (
                            typeof this.applyNow ===
                            'function'
                        ) {

                            this.applyNow();
                        }

                    } catch (err) {

                        warn(
                            '精煉補丁失敗',
                            err
                        );

                        return original.call(
                            this,
                            e
                        );
                    }
                };

            markPatched(
                proto,
                'refineStack'
            );
        }

        patchState.active = true;

        try {
            getWindow().__idleSealSession = s;
        } catch (e) {}

        log(
            'Patch 完成',
            Object.assign({}, mults)
        );

        updateStatus(
            '✅ 已套用 Patch'
        );

        return true;
    }

    /* =========================================================
       尋找 Session Loop
    ========================================================= */

    function tryFindSession() {

        const found =
            locateSession();

        if (!found) {

            patchState.active = false;

            updateStatus(
                '⏳ 尋找遊戲 session 中...'
            );

            return false;
        }

        if (
            session !== found ||
            !patchState.active
        ) {

            session = found;

            try {
                getWindow().__idleSealSession =
                    found;
            } catch (e) {}

            applyPatches(found);

            return true;
        }

        return true;
    }

    function startSessionWatcher() {

        if (locateTimer) {
            clearInterval(locateTimer);
        }

        locateTimer =
            setInterval(() => {

                try {
                    tryFindSession();
                } catch (e) {
                    warn(
                        'Session watcher error',
                        e
                    );
                }

            }, 1500);

        tryFindSession();
    }

    /* =========================================================
       UI
    ========================================================= */

    let panel = null;
    let body = null;
    let statusEl = null;
    let sizeLabel = null;

    function updateStatus(text) {

        if (statusEl) {
            statusEl.textContent =
                text;
        }
